<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SGP" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/brand_final_primary</item>
        <item name="colorOnPrimary">@color/brand_final_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_final_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_final_on_primary_container</item>

        <!-- Tertiary — the amber accent, used sparingly (outlines, highlights, badges) -->
        <item name="colorTertiary">@color/brand_final_accent</item>
        <item name="colorOnTertiary">@color/brand_final_on_accent</item>
        <item name="colorTertiaryContainer">@color/brand_final_accent</item>
        <item name="colorOnTertiaryContainer">@color/brand_final_on_accent</item>

        <!-- Secondary (kept as your existing soft green for stat-card icons / "Live" badges) -->
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorOnSecondary">@color/text_inverse</item>
        <item name="colorSecondaryContainer">@color/primary_green_container</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Surface -->
        <item name="colorSurface">@color/brand_final_surface</item>
        <item name="colorOnSurface">@color/brand_final_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_final_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_final_on_surface_variant</item>
        <item name="android:colorBackground">@color/brand_final_background</item>
        <item name="colorOnBackground">@color/brand_final_on_background</item>

        <!-- Outline / borders / dividers -->
        <item name="colorOutline">@color/brand_final_primary</item>
        <item name="colorOutlineVariant">@color/brand_final_outline_variant</item>

        <!-- Feedback -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_inverse</item>
        <item name="colorErrorContainer">@color/error_soft</item>

        <!-- Text defaults — dark text on the light warm background -->
        <item name="android:textColorPrimary">@color/brand_final_on_background</item>
        <item name="android:textColorSecondary">@color/brand_final_on_surface_variant</item>
        <item name="android:textColorHint">@color/grey_500</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/brand_final_background</item>
        <item name="android:navigationBarColor">@color/brand_final_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <style name="Theme.SGP.Admin" parent="Theme.SGP">
        <item name="android:navigationBarColor">@color/admin_bg_light_blue</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>