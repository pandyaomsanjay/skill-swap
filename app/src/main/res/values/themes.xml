<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SGP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_green_container</item>
        <!-- Surface -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <!-- System Bars -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Admin-only theme: light blue nav bar instead of green -->
    <style name="Theme.SGP.Admin" parent="Theme.SGP">
        <item name="android:navigationBarColor">@color/admin_bg_light_blue</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>