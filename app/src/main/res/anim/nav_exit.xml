<?xml version="1.0" encoding="utf-8"?>
<!--
  nav_exit.xml
  Plays on the OUTGOING admin screen when switching between the 5 admin tabs.
  Pairs with nav_enter.xml via overridePendingTransition(nav_enter, nav_exit).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator">

    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="200" />

    <scale
        android:fromXScale="1.0"
        android:toXScale="1.04"
        android:fromYScale="1.0"
        android:toYScale="1.04"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="200" />

</set>