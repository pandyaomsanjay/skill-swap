<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_light_blue">

    <!-- ===================== Decorative floating shapes ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-90dp"
        app:cardCornerRadius="120dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#141B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-45dp"
        android:layout_marginStart="-45dp"
        app:cardCornerRadius="85dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-55dp"
        app:cardCornerRadius="75dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1E1B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-65dp"
        app:cardCornerRadius="95dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <!-- ===================== Transparent toolbar (no back — token screen) ===================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent" />

    <!-- ===================== Static content ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="36dp"
            android:gravity="center_horizontal">

            <!-- Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="72dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="46dp"
                app:cardElevation="10dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/brand_tan"
                app:cardBackgroundColor="@color/surface">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/outline_lock_24"
                    app:tint="@color/brand_navy"
                    android:contentDescription="Reset Password" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create new password"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.005"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your new password must be different from previously used passwords"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.02"
                android:gravity="center"
                android:layout_marginBottom="36dp" />

            <!-- New Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New Password"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusTopStart="26dp"
                app:boxCornerRadiusTopEnd="26dp"
                app:boxCornerRadiusBottomStart="26dp"
                app:boxCornerRadiusBottomEnd="26dp"
                app:boxStrokeColor="@color/brand_navy"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/outline_lock_24"
                app:startIconTint="@color/brand_navy"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Live rule checklist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/ruleLength"
                    style="@style/RuleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• At least 8 characters" />

                <TextView
                    android:id="@+id/ruleUpper"
                    style="@style/RuleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 1 uppercase letter" />

                <TextView
                    android:id="@+id/ruleNumber"
                    style="@style/RuleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 1 number" />

                <TextView
                    android:id="@+id/ruleSpecial"
                    style="@style/RuleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 1 special character" />

            </LinearLayout>

            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmPasswordLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Password"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusTopStart="26dp"
                app:boxCornerRadiusTopEnd="26dp"
                app:boxCornerRadiusBottomStart="26dp"
                app:boxCornerRadiusBottomEnd="26dp"
                app:boxStrokeColor="@color/brand_navy"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/outline_lock_24"
                app:startIconTint="@color/brand_navy"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvMatchIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:paddingStart="14dp"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="Reset Password"
                android:enabled="false"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="29dp"
                app:elevation="8dp"
                app:rippleColor="@color/overlay_light" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/brand_navy"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>