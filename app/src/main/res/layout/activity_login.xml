<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_light_blue">

    <!-- ===================== Decorative floating shapes ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-90dp"
        app:cardCornerRadius="120dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#141B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-45dp"
        android:layout_marginStart="-45dp"
        app:cardCornerRadius="85dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-55dp"
        app:cardCornerRadius="75dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1E1B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-65dp"
        app:cardCornerRadius="95dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="60dp"
        android:layout_marginStart="30dp"
        app:cardCornerRadius="55dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#331B3C53" />

    <!-- ===================== Static content ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="36dp"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="52dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="46dp"
                app:cardElevation="10dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/brand_tan"
                app:cardBackgroundColor="@color/surface">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo2"
                    android:contentDescription="SkillSwap Logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back!"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.005"
                android:layout_marginBottom="6dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue your skill journey"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.02"
                android:layout_marginBottom="40dp" />

            <!-- ===================== Form — pill-shaped fields ===================== -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusTopStart="26dp"
                app:boxCornerRadiusTopEnd="26dp"
                app:boxCornerRadiusBottomStart="26dp"
                app:boxCornerRadiusBottomEnd="26dp"
                app:boxStrokeColor="@color/brand_navy"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/outline_mail_24"
                app:startIconTint="@color/brand_navy"
                app:endIconMode="clear_text"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusTopStart="26dp"
                app:boxCornerRadiusTopEnd="26dp"
                app:boxCornerRadiusBottomStart="26dp"
                app:boxCornerRadiusBottomEnd="26dp"
                app:boxStrokeColor="@color/brand_navy"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/outline_lock_24"
                app:startIconTint="@color/brand_navy"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="@color/brand_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:layout_marginBottom="30dp" />

            <!-- Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="29dp"
                app:elevation="8dp"
                app:rippleColor="@color/overlay_light"
                android:layout_marginBottom="26dp" />

            <!-- OR divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/brand_tan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR CONTINUE WITH"
                    android:textColor="@color/text_hint"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/brand_tan" />
            </LinearLayout>

            <!-- Google Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleLogin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Continue with Google"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/surface"
                app:strokeColor="@color/brand_tan"
                app:strokeWidth="1.5dp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_google_logo"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:layout_marginBottom="28dp" />

            <!-- Create Account Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvSignInPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New to SkillSwap?  "
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvCreateAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="@color/brand_navy"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/brand_navy"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>