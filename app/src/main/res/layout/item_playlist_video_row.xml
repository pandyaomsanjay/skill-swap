<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#D2C1B6"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvVideoOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1."
            android:textColor="#456882"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <!-- FEATURE 2: checkmark shown in place of tvVideoOrder once this video
             is in the learner's completedVideoIds set. Same slot, same end margin,
             so the row layout doesn't shift when toggled. -->
        <ImageView
            android:id="@+id/ivVideoCompleted"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/baseline_check_circle_24"
            app:tint="@color/success"
            android:contentDescription="Completed"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Title"
                android:textColor="#1B3C53"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvVideoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#456882"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#9AA7B0"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <!-- NEW: Feedback (rating/comment) on this specific video. Same slot
             style as btnReportVideo, placed before it so Report stays the
             right-most/most-destructive-feeling action. Uses a text emoji
             instead of a drawable to avoid depending on an icon resource
             that may not exist in this project (see ic_flag below, which
             is only safe because it's already used by btnReportVideo). -->
        <TextView
            android:id="@+id/btnFeedbackVideo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Give feedback on video"
            android:clickable="true"
            android:focusable="true" />

        <!-- Report this specific video. Hidden for the playlist owner viewing
             their own upload (set in PlaylistVideoAdapter#onBindViewHolder). -->
        <ImageView
            android:id="@+id/btnReportVideo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_flag"
            app:tint="#9AA7B0"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Report video"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>