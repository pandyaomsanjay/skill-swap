<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#D2C1B6"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- Top Row: Radio + Coin + Title/Credits + Price Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Selection Radio indicator -->
                <FrameLayout
                    android:id="@+id/selectionIndicator"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/ic_selection_ring_outline" />

                    <View
                        android:id="@+id/selectionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ic_selection_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Coin Icon Circle -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_coin_circle"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_coin_credits"
                        android:contentDescription="Coin" />
                </FrameLayout>

                <!-- Name & Credits Stack -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPackageName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Starter"
                        android:textColor="#1B3C53"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPackageCredits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 Credits"
                        android:textColor="#0D47A1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Price Pill -->
                <TextView
                    android:id="@+id/tvPackagePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹50"
                    android:textColor="#1B3C53"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_price_pill"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Bottom Row: Value / Bonus / Savings strip (vertical separation) -->
            <TextView
                android:id="@+id/tvPackageSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 +20 Bonus Credits (10% extra)"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_savings_banner"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Top-Left promotional badge (clean separation from price pill) -->
    <TextView
        android:id="@+id/tvPackageBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:text="MOST POPULAR"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_package_badge"
        android:visibility="gone"
        android:elevation="4dp" />

</FrameLayout>
