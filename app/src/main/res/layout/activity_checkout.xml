<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/checkoutRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF1F5"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCheckout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1B3C53"
        android:elevation="6dp"
        app:titleTextColor="#F9F3EF"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- DEMO MODE Header Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvDemoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEMO MODE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_demo_mode_badge" />

                <TextView
                    android:id="@+id/tvDemoNotice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Simulated payment for demonstration only. No real money will be charged."
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selected Package Summary Card -->
            <TextView
                android:id="@+id/tvPackageSummaryHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="#1B3C53"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOrderSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#D2C1B6"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_coin_circle"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_coin_credits"
                                android:contentDescription="Credits coin" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCheckoutPackageName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Popular"
                                android:textColor="#1B3C53"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCheckoutPackageCredits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+220 Credits"
                                android:textColor="#0D47A1"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCheckoutPackagePrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹100"
                            android:textColor="#1B3C53"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tvCheckoutDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="One-time demo purchase · Added immediately to your credit balance"
                        android:textColor="#456882"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Method Selection -->
            <TextView
                android:id="@+id/tvPaymentMethodHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Demo Payment Method"
                android:textColor="#1B3C53"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPaymentMethodSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose how you want to simulate this transaction."
                android:textColor="#456882"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- Option 1: UPI Simulation -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodUpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#D2C1B6"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Radio Indicator -->
                    <FrameLayout
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/ic_selection_ring_outline" />

                        <View
                            android:id="@+id/dotMethodUpi"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_selection_dot"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_simulated_upi"
                        app:tint="#1B3C53"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="UPI icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitleUpi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPI Simulation"
                            android:textColor="#1B3C53"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubUpi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulates instant Google Pay / PhonePe authorization"
                            android:textColor="#456882"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2: Card Simulation -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#D2C1B6"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Radio Indicator -->
                    <FrameLayout
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/ic_selection_ring_outline" />

                        <View
                            android:id="@+id/dotMethodCard"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_selection_dot"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_simulated_card"
                        app:tint="#1B3C53"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Card icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitleCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Card Simulation"
                            android:textColor="#1B3C53"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulates Visa / Mastercard 3D-Secure payment"
                            android:textColor="#456882"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Processing Status Indicator -->
            <LinearLayout
                android:id="@+id/layoutProcessing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressBarCheckout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorColor="#1B3C53"
                    app:trackColor="#D2C1B6"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvProcessingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Processing your demo transaction..."
                    android:textColor="#1B3C53"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimulatePayment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="8dp"
        android:text="Select a Payment Method"
        android:textAllCaps="false"
        android:textColor="#F9F3EF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:enabled="false"
        style="@style/Widget.Material3.Button.TonalButton"
        app:backgroundTint="#1B3C53"
        app:cornerRadius="28dp" />

</LinearLayout>
