<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#EAF1F5"
    tools:context=".AboutActivity">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B3C53"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#456882"
            app:cardBackgroundColor="#456882"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivBackIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/outline_arrow_back_24"
                app:tint="#F9F3EF"
                android:contentDescription="@null"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="About SkillSwap"
            android:textColor="#F9F3EF"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.01"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Brand card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2C1B6"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLogoCircle"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EAE1DA">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/logo2"
                            android:scaleType="centerInside" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="SkillSwap"
                        android:textColor="#1B3C53"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Version 1.0.0"
                        android:textColor="#456882"
                        android:textSize="12.5sp" />

                    <View
                        android:id="@+id/dividerBrand"
                        android:layout_width="36dp"
                        android:layout_height="1dp"
                        android:background="#D2C1B6"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trade skills, not cash."
                        android:textColor="#1B3C53"
                        android:textSize="14.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="SkillSwap connects people who want to learn with people who want to teach. Earn credits by sharing what you know, then spend them to pick up something new — no money changes hands."
                        android:textColor="#456882"
                        android:lineSpacingExtra="5dp"
                        android:textSize="13.5sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:id="@+id/barSectionMore"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#1B3C53"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvSectionMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More"
                    android:textColor="#1B3C53"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2C1B6"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Privacy Policy row -->
                    <LinearLayout
                        android:id="@+id/layoutAboutPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconBgAboutPrivacy"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EAE1DA">

                            <ImageView
                                android:id="@+id/ivIconAboutPrivacy"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/outline_privacy_tip_24"
                                app:tint="#1B3C53" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvAboutPrivacy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Privacy Policy"
                            android:textColor="#1B3C53"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivChevronAboutPrivacy"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/outline_chevron_right_24"
                            app:tint="#456882" />

                    </LinearLayout>

                    <View
                        android:id="@+id/dividerAbout1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EAE1DA"
                        android:layout_marginStart="12dp" />

                    <!-- Terms row -->
                    <LinearLayout
                        android:id="@+id/layoutAboutTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconBgAboutTerms"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EAE1DA">

                            <ImageView
                                android:id="@+id/ivIconAboutTerms"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/outline_conditions_24"
                                app:tint="#1B3C53" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvAboutTerms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Terms of Service"
                            android:textColor="#1B3C53"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivChevronAboutTerms"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/outline_chevron_right_24"
                            app:tint="#456882" />

                    </LinearLayout>

                    <View
                        android:id="@+id/dividerAbout2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EAE1DA"
                        android:layout_marginStart="12dp" />

                    <!-- Help row -->
                    <LinearLayout
                        android:id="@+id/layoutAboutHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconBgAboutHelp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EAE1DA">

                            <ImageView
                                android:id="@+id/ivIconAboutHelp"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/outline_help_24"
                                app:tint="#1B3C53" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvAboutHelp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Help &amp; Support"
                            android:textColor="#1B3C53"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivChevronAboutHelp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/outline_chevron_right_24"
                            app:tint="#456882" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Made with care by the SkillSwap team"
                android:textColor="#456882"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>