<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF1F5"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1B3C53"
        app:title="Add Video to Playlist"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/outline_arrow_back_24"
        app:navigationIconTint="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Video Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2C1B6"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Video"
                        android:textColor="#1B3C53"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Preview area -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="#000000"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivVideoThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_videocam_24"
                            android:contentDescription="Video thumbnail" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No video selected"
                        android:textColor="#757575"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#9AA7B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Max file size: 50 MB"
                        android:textColor="#9AA7B0"
                        android:textSize="11sp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnSelectVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select / Upload Video"
                        android:textAllCaps="false"
                        android:backgroundTint="#456882"
                        android:textColor="@android:color/white"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2C1B6"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Details"
                        android:textColor="#1B3C53"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Video Title"
                        app:boxStrokeColor="#456882"
                        app:hintTextColor="#1B3C53">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVideoTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1B3C53" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Video Description"
                        app:boxStrokeColor="#456882"
                        app:hintTextColor="#1B3C53">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVideoDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="3"
                            android:inputType="textMultiLine"
                            android:textColor="#1B3C53" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Category (Optional)"
                        app:boxStrokeColor="#456882"
                        app:hintTextColor="#1B3C53">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVideoCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1B3C53" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Video Duration (auto)"
                        app:boxStrokeColor="#456882"
                        app:hintTextColor="#1B3C53"
                        android:enabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVideoDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#9AA7B0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Credits -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Credits for this Video"
                        android:textColor="#1B3C53"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnVideoDecrement"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Decrease credits"
                            app:tint="#1B3C53"
                            android:src="@drawable/baseline_remove_24" />

                        <TextView
                            android:id="@+id/tvVideoCredits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1B3C53"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="20dp" />

                        <ImageButton
                            android:id="@+id/btnVideoIncrement"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/outline_add_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Increase credits"
                            app:tint="#1B3C53" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Set credits required to access this video individually"
                        android:textColor="#9AA7B0"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2C1B6"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Order in Playlist"
                        android:textColor="#1B3C53"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnOrderDecrement"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Decrease order"
                            app:tint="#1B3C53"
                            android:src="@drawable/baseline_remove_24" />

                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#1B3C53"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="20dp" />

                        <ImageButton
                            android:id="@+id/btnOrderIncrement"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/outline_add_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Increase order"
                            app:tint="#1B3C53" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="This video will be added at position #1"
                        android:textColor="#456882"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:backgroundTint="#EAF1F5"
                    android:textColor="#456882"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddVideoToPlaylist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Add Video"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#1B3C53" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>