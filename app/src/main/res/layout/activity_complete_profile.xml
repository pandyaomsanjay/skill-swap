<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_light_blue">

    <!-- ===================== Decorative floating shapes ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-90dp"
        app:cardCornerRadius="120dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#141B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-45dp"
        android:layout_marginStart="-45dp"
        app:cardCornerRadius="85dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-55dp"
        app:cardCornerRadius="75dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1E1B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-65dp"
        app:cardCornerRadius="95dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#221B3C53" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="60dp"
        android:layout_marginStart="30dp"
        app:cardCornerRadius="55dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#331B3C53" />

    <!-- ===================== Scrolling content ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="36dp"
            android:gravity="center_horizontal">

            <!-- Step Indicator (3 dots) -->
            <LinearLayout
                android:id="@+id/stepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/step_dot_inactive"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/step_dot_inactive"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/step_dot_active" />

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_profile_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.005"
                android:layout_marginBottom="6dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_profile_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.02"
                android:layout_marginBottom="28dp" />

            <!-- Profile Picture -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_default_profile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_circle_white"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignBottom="@id/profileImage"
                    android:layout_alignEnd="@id/profileImage"
                    android:background="@drawable/bg_circle_primary"
                    android:src="@drawable/outline_photo_camera_24"
                    android:contentDescription="@string/cd_change_photo"
                    android:padding="6dp" />
            </RelativeLayout>

            <!-- ===================== Full Name (icon outside, left) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivNameIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/outline_person_24"
                    app:tint="@color/brand_navy"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/full_name"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/brand_navy"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== Location (icon outside, left) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivLocationIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/outline_location_on_24"
                    app:tint="@color/brand_navy"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/locationLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/current_location"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/brand_navy"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/text_secondary"
                    android:layout_marginEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/btnAutoDetect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/outline_my_location_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auto_detect_location"
                    app:tint="@color/brand_navy" />
            </LinearLayout>

            <!-- Validation icon -->
            <ImageView
                android:id="@+id/locationValidationIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- ===================== Language (icon outside, left) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/ivLanguageIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/outline_language_24"
                    app:tint="@color/brand_navy"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/languageLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/preferred_language"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/brand_navy"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/text_secondary">

                    <AutoCompleteTextView
                        android:id="@+id/etLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:paddingStart="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="@string/save_profile"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="29dp"
                app:elevation="8dp"
                app:rippleColor="@color/overlay_light"
                android:enabled="false" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>