<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1B3C53">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- ===================== Dashboard (active by default) ===================== -->
            <LinearLayout
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_dashboard"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDashboardIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/ivDashboardIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_home_24"
                        app:tint="#1B3C53"
                        android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================== Users ===================== -->
            <LinearLayout
                android:id="@+id/navUsers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_users"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUsersIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000">

                    <ImageView
                        android:id="@+id/ivUsersIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_people_outline_24"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================== Swaps ===================== -->
            <LinearLayout
                android:id="@+id/navSwaps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_swaps"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSwapsIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000">

                    <ImageView
                        android:id="@+id/ivSwapsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/outline_handshake_24"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================== Reports ===================== -->
            <LinearLayout
                android:id="@+id/navReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_reports"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportsIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000">

                    <ImageView
                        android:id="@+id/ivReportsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/outline_flag_24"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================== Feedback ===================== -->
            <LinearLayout
                android:id="@+id/navFeedback"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_feedback"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedbackIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000">

                    <ImageView
                        android:id="@+id/ivFeedbackIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/outline_chat_bubble_outline_24"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>