<?xml version="1.0" encoding="utf-8"?>
<!-- Resolve Report pill. Green kept muted/desaturated so it sits comfortably
     next to the navy/tan admin palette instead of looking like a stock
     Material "success" color. -->
<selector xmlns:android="http://schemas.android.com/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#256349" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2F7D5C" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>